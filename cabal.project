packages:
    .
    ../persistent-effectful
    ../vinyl
    ../porcupine/docrecords
    ../IDA/projects/effectful/servant
    ../IDA/projects/effectful/wai
    ../IDA/projects/effectful/warp
    ../IDA/projects/effectful/http-client
    ../servant/servant
    ../servant/servant-server
    ../servant/servant-client
    ../servant/servant-client-core
    ../servant/servant-openapi3
    ../mcp/mcp-types
    ../mcp/mcp-client
    ../mcp/mcp-effectful

with-compiler: ghc-9.12.2

package servant
  ghc-options: -Wno-deriving-typeable -Wno-deprecations

package servant-server
  ghc-options: -Wno-deriving-typeable -Wno-missing-methods -Wno-deprecations

write-ghc-environment-files: always
